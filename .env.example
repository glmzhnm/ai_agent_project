# Какой провайдер модели использовать: anthropic или openai
LLM_PROVIDER=anthropic

# Нужен только ключ выбранного провайдера
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Необязательно: переопределить модель
# LLM_MODEL=claude-haiku-4.5

LLM_TIMEOUT_SECONDS=45
MAX_QUESTION_CHARS=1500
ALLOWED_ORIGINS=http://localhost:5173

# Postgres с историей тикетов команды (docker-compose поднимает эти же значения)
DATABASE_URL=postgresql://assistant:assistant@localhost:55432/assistant

# Секрет для подписи JWT-сессий. Сгенерировать: openssl rand -hex 32
JWT_SECRET=
